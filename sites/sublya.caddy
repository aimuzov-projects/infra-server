# Sublya: сайт и админка бота (Mini App) из репо aimuzov/sublya
# (/srv/sublya), оба на одном домене.

sublya.aimuzov.online {
	import common

	# Telegram Web открывает админку в своём iframe, поэтому вместо SAMEORIGIN из common
	# здесь список разрешённых origin'ов. Без defer заголовок из common вернётся
	# после удаления.
	@admin path /admin /admin/*
	header @admin {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org"
		defer
	}

	handle @admin {
		reverse_proxy sublya-tunnel:8090
	}

	handle {
		reverse_proxy sublya-site:80
	}
}
