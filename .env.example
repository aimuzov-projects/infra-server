# Секреты инфраструктуры. На сервере лежат в /srv/infra-server/.env, в git их нет.
# Ссылка на подписку Alesha Vpnov, по ней vpn/update.sh собирает vpn/config.json.
VPN_SUBSCRIPTION_URL=

# Хеш пароля редактора taplist (basic_auth в sites/community-taplist.caddy). Получить так:
#   docker run --rm -it caddy:2.10-alpine caddy hash-password
# Значение держим в одинарных кавычках, иначе compose примет $ из bcrypt за переменные.
TAPLIST_EDITOR_HASH=
