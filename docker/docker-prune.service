[Unit]
Description=Drop Docker build cache older than a week
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Every deploy builds images, and the cache of old builds is never used again: on the 30 GB disk
# it took 18 GB. A week keeps what the next deploys of every project still reuse.
ExecStart=/usr/bin/docker builder prune --force --filter until=168h
