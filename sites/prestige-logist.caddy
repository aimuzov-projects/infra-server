# Assignment converter, repo aimuzov-projects/prestige-logist, on the server
# in /srv/prestige-logist.

logist.aimuzov.online {
	import common

	# An assignment bundle can be up to 20 MB. Over that the API answers 413.
	request_body /api/* {
		max_size 21MB
	}

	handle /api/* {
		reverse_proxy prestige-logist-api:8787
	}

	handle {
		reverse_proxy prestige-logist:80
	}
}
