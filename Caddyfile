# Каждый сайт живёт в своём файле в sites/, здесь только общее.

(common) {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Только HTTPS на год. Без includeSubDomains: часть поддоменов обслуживается не отсюда.
		Strict-Transport-Security "max-age=31536000"
		# Камера, микрофон, геолокация и платежи здешним сайтам не нужны. "?" выставляет
		# заголовок, только если сайт не задал свой. Дело в том что из-за -Server блок
		# отложенный, и без "?" он перетёр бы заголовок сайта.
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

import sites/*.caddy
