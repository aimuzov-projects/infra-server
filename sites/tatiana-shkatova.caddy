# Сайт Татьяны Шкатовой, репо aimuzov/shkatova-psychologist,
# на сервере в /srv/shkatova-psychologist.

www.tatiana-shkatova.ru {
	redir https://tatiana-shkatova.ru{uri} permanent
}

tatiana-shkatova.ru {
	import common

	# Чат отвечает потоком (SSE), с буферизацией прокси ответ придёт только целиком в конце.
	handle /api/* {
		reverse_proxy shkatova-chat:8787 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy shkatova-psychologist:80
	}
}
