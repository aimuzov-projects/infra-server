# Tatiana Shkatova's site, repo aimuzov-projects/shkatova-psychologist,
# on the server in /srv/shkatova-psychologist.

www.tatiana-shkatova.ru {
	redir https://tatiana-shkatova.ru{uri} permanent
}

tatiana-shkatova.ru {
	import common

	# The chat replies with a stream (SSE): proxy buffering would hold the response until the end.
	handle /api/* {
		reverse_proxy shkatova-chat:8787 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy shkatova-psychologist:80
	}
}
