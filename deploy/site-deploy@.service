[Unit]
Description=Deploy of the site %i
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/srv/infra-server/deploy/site-build.sh %i
# git ходит в GitHub с ключами клонов из /root/.ssh/config.
Environment=HOME=/root
# С запасом на ожидание в очереди за другими сайтами плюс на саму сборку.
TimeoutStartSec=30min
