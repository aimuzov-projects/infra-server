# Игра Codenames, репо aimuzov/codenames, на сервере в /srv/codenames.

codenames.aimuzov.online {
	import common

	# QR-сканеру в игре нужна камера, а общий сниппет её запрещает. Собственный заголовок
	# сайта сниппет не перетирает (см. "?" в Caddyfile).
	header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"

	# Онлайн-комнаты ходят через WebSocket, upgrade reverse_proxy пробрасывает сам.
	handle /ws* {
		reverse_proxy codenames-relay:8787
	}

	handle {
		reverse_proxy codenames:80
	}
}
