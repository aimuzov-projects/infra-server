# Таплист бара, репо aimuzov/community-taplist, на сервере в /srv/community-taplist.

taplist.aimuzov.online {
	import common

	# ТВ-доски открыты без пароля, а редактор и сохранение списка -- только для барменов.
	# Хеш берётся из .env на сервере (см. compose.yml), так как репо публичное.
	@editor expression path("/editor*") || (method("PUT") && path("/api/items"))
	basic_auth @editor {
		admin {$TAPLIST_EDITOR_HASH}
	}

	# Редактор отправляет весь список вместе с обложками, до 16 МБ. Больше -- API отвечает 413.
	request_body /api/* {
		max_size 17MB
	}

	handle /api/* {
		reverse_proxy community-taplist-api:8787
	}

	handle {
		reverse_proxy community-taplist:80
	}
}
