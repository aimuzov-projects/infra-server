# Each site lives in its own file under sites/, only the shared bits go here.

(common) {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# HTTPS only for a year. No includeSubDomains: some subdomains aren't served from here.
		Strict-Transport-Security "max-age=31536000"
		# Sites here don't need camera, mic, geolocation or payments. "?" sets it only if the site
		# hasn't set its own: the block is deferred because of -Server, so otherwise it would
		# overwrite the site's header.
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

import sites/*.caddy
