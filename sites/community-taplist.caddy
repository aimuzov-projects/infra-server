# Bar taplist, repo aimuzov-projects/community-taplist, on the server in /srv/community-taplist.

taplist.aimuzov.online {
	import common

	# TV boards stay open without a password, the editor and saving the list are for bartenders.
	# The hash comes from the server's .env (see compose.yml), the repo is public.
	@editor expression path("/editor*") || (method("PUT") && path("/api/items"))
	basic_auth @editor {
		admin {$TAPLIST_EDITOR_HASH}
	}

	# The editor sends the whole list with covers, up to 16 MB. Over that the API answers 413.
	request_body /api/* {
		max_size 17MB
	}

	handle /api/* {
		reverse_proxy community-taplist-api:8787
	}

	handle {
		reverse_proxy community-taplist:80
	}
}
