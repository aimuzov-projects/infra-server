[Unit]
Description=Drop Docker build cache older than a week
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Каждый деплой собирает образы, а кеш старых сборок больше не используется: на диске
# в 30 ГБ он занимал 18 ГБ. Неделю храним потому что это ещё переиспользуют следующие
# деплои всех проектов.
ExecStart=/usr/bin/docker builder prune --force --filter until=168h
