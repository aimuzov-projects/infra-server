# Конвертер заявок, репо aimuzov/prestige-logist, на сервере
# в /srv/prestige-logist.

logist.aimuzov.online {
	import common

	# Пачка заявок может весить до 20 МБ. Больше -- API отвечает 413.
	request_body /api/* {
		max_size 21MB
	}

	handle /api/* {
		reverse_proxy prestige-logist-api:8787
	}

	handle {
		reverse_proxy prestige-logist:80
	}
}
