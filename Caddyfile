# Каждый сайт описан своим файлом в sites/, тут только общее.

(common) {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Год только по HTTPS. Без includeSubDomains: у доменов бывают поддомены не отсюда.
		Strict-Transport-Security "max-age=31536000"
		# Сайтам с сервера не нужны камера, микрофон, геолокация и оплата. «?» -- только если сайт
		# не задал свой: блок отложен из-за -Server и иначе перезаписал бы заголовок сайта.
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

import sites/*.caddy
