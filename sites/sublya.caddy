# Sublya: the site from repo sublya/site (/srv/sublya-site) and the bot's Mini App admin
# from sublya/bot (/srv/sublya-bot), both on one domain.

sublya.aimuzov.online {
	import common

	# Telegram Web opens the admin in its own iframe, so instead of SAMEORIGIN from common
	# there's a list of allowed origins. defer, otherwise common's header comes back after removal.
	@admin path /admin /admin/*
	header @admin {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org"
		defer
	}

	handle @admin {
		reverse_proxy sublya-tunnel:8090
	}

	handle {
		reverse_proxy sublya-site:80
	}
}
