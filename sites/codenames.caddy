# Codenames game, repo aimuzov-projects/codenames, on the server in /srv/codenames.

codenames.aimuzov.online {
	import common

	# The in-game QR scanner needs the camera, and the shared snippet blocks it. The snippet
	# leaves a site's own header alone (see "?" in Caddyfile).
	header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"

	# Online rooms relay over WebSocket: reverse_proxy passes the upgrade through by itself.
	handle /ws* {
		reverse_proxy codenames-relay:8787
	}

	handle {
		reverse_proxy codenames:80
	}
}
