# Infrastructure secrets. On the server they live in /srv/infra-server/.env, never in git.
# Alesha Vpnov subscription URL, vpn/update.sh builds vpn/config.json from it.
VPN_SUBSCRIPTION_URL=

# Taplist editor password hash (basic_auth in sites/community-taplist.caddy). To get one:
#   docker run --rm -it caddy:2.10-alpine caddy hash-password
# Keep the value in single quotes, otherwise compose treats the $ in bcrypt as variables.
TAPLIST_EDITOR_HASH=
